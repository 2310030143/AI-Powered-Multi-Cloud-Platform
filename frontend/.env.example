# Base URL of the FastAPI backend (Phases 1-6).
# Default (empty/omitted): "/api/v1" — a RELATIVE URL served through the Vite
# dev proxy (see vite.config.ts), which works for local development without
# any CORS setup. For a deployed frontend, set the absolute backend URL:
# VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=/api/v1

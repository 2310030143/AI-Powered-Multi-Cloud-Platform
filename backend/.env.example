# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME="AI File Intelligence Platform"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/file_intelligence

# ─── Google Cloud / Drive ─────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/cloud/google/callback

# ─── S3-compatible object storage (Backblaze B2 free tier / AWS S3 / MinIO) ──
# Backblaze B2 — 10 GB free, no credit card: https://www.backblaze.com/cloud-storage
#   1. Create an account → B2 Cloud Storage → Create Bucket (Private)
#   2. App Keys → Add a New Application Key restricted to that bucket
#   3. Put the keyID / key here and set S3_ENDPOINT_URL to the bucket's
#      S3 endpoint, e.g. https://s3.us-west-004.backblazeb2.com
# Leave S3_ENDPOINT_URL empty to use real AWS S3 instead.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-west-004
S3_BUCKET_NAME=
S3_ENDPOINT_URL=

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Vector DB (Qdrant) ───────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=document_chunks

# ─── Document processing (Phase 3) ────────────────────────────────────────────
# Local cache for downloaded files during document processing
LOCAL_STORAGE_PATH=./storage

# Target chunk size and overlap
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# Maximum number of PDF pages that may be sent through OCR
OCR_MAX_PAGES=50


# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000"]

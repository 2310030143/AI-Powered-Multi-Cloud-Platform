# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME="AI File Intelligence Platform"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/file_intelligence

# ─── Google Cloud / Drive ─────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/cloud/google/callback
# Path to downloaded service account JSON (for server-to-server access)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── AWS ──────────────────────────────────────────────────────────────────────
# Use an IAM user with ONLY s3:GetObject, s3:PutObject, s3:ListBucket permissions
# Never use root credentials here
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Vector DB (Qdrant) ───────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=document_chunks

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000"]
